{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceFlow",
  "version": "0.1.0",
  "identifier": "com.voiceflow.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoiceFlow",
        "url": "index.html",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "VoiceFlow Overlay",
        "url": "index.html#overlay",
        "width": 480,
        "height": 100,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../../bin/*",
      "../../../apps/api/dist/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNjIwNjhCMjAzMDJCQTEKUldTaEt6QWdpd1ppMGlPZ2w2U0tLOUpJeFRCVFlsaVVkZ3doOG1pMnBqczFqVTNsMmltUTdhbEkK",
      "endpoints": [
        "https://github.com/Utpal4505/voiceflow/releases/latest/download/latest.json"
      ]
    }
  }
}
