# =============================================================================
# VOICEFLOW WEB — POSTHOG ANALYTICS CONFIGURATION
# =============================================================================
# 1. Sign up or log into your PostHog dashboard at https://app.posthog.com (or https://eu.posthog.com)
# 2. Go to Project Settings -> Project Variables -> Project API Key
# 3. Copy your project key (starts with "phc_...") and paste it below:

NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key_here

# PostHog API Host:
# - US Region: https://us.i.posthog.com (default)
# - EU Region: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
